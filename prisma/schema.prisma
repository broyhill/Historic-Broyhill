generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Names injected automatically by the Supabase↔Vercel integration:
  // POSTGRES_PRISMA_URL = transaction pooler (pgbouncer) for serverless queries,
  // POSTGRES_URL_NON_POOLING = direct connection for migrations.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model BusinessProfile {
  id              String              @id @default(uuid())
  businessName    String
  industry        String
  referenceUrls   String[]            @default([])
  designTokens    Json?
  marketingTracks String[]            @default([])
  createdAt       DateTime            @default(now())
  campaigns       AiContentPipeline[]
  leads           LeadProfile[]
}

model LeadProfile {
  id               String          @id @default(uuid())
  businessId       String
  email            String          @unique
  name             String?
  salutation       String?
  firstName        String?
  middleName       String?
  lastName         String?
  company          String?
  phone            String?
  linkedinId       String?
  companyLinkedin  String?
  city             String?
  state            String?
  enrichedAt       DateTime?
  personSearchedAt DateTime?
  leadScore        Int             @default(0)
  leadStatus       String          @default("PROSPECT")
  primaryTrack     String
  leadSource       String          @default("IN_PERSON_NFC")
  estimatedValue   Float?
  customFields     Json?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  activities       LeadActivity[]
  journeyRuns      JourneyRun[]
  business         BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([email])
}

model LeadActivity {
  id            String      @id @default(uuid())
  leadId        String
  activityType  String
  scoreModifier Int
  metadata      Json?
  createdAt     DateTime    @default(now())
  lead          LeadProfile @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model AiContentPipeline {
  id             String          @id @default(uuid())
  businessId     String
  channel        String          @default("EMAIL")
  suggestedDraft String
  mediaUrls      Json?
  status         String          @default("PENDING_REVIEW")
  scheduledFor   DateTime        @default(now())
  publishedAt    DateTime?
  metrics        Json?
  createdAt      DateTime        @default(now())
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Email campaign draft (the Campaign Monitor-style checklist: subject, sender,
// recipients, design, review). Phase 1 never sends to a list; see lib/campaigns-db.ts,
// which creates this table idempotently on first use (CREATE TABLE IF NOT EXISTS).
model EmailCampaign {
  id              String   @id @default(uuid())
  name            String
  status          String   @default("DRAFT") // DRAFT | READY
  subject         String   @default("")
  previewText     String   @default("")
  fromName        String   @default("")
  fromEmail       String   @default("")
  replyTo         String?
  recipientFilter Json?
  recipientCount  Int      @default(0)
  designType      String   @default("plain") // plain | html
  body            String   @default("")
  aiBrief         Json?
  testSends       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Journeys: automatic multi-step follow-up (email, text, waits) started by a trigger.
// Created idempotently on first use by lib/journeys-db.ts. Nothing here sends anything by
// itself: the runner (added later) puts messages in the Review Queue unless a journey has
// approvalMode AUTO.
model Journey {
  id           String       @id @default(uuid())
  name         String
  trigger      String // INQUIRY_RECEIVED | TOUR_BOOKED | EVENT_COMPLETED | MANUAL
  status       String       @default("PAUSED") // ACTIVE | PAUSED
  approvalMode String       @default("REVIEW") // REVIEW | AUTO
  steps        Json         @default("[]") // ordered steps, see lib/journeys.ts
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  runs         JourneyRun[]
}

// Venue bookings backbone (the "Event spine"). A VenueEvent is one real gathering:
// inquiry → tentative → booked → completed, with rooms, date and AI-drafted
// proposal / run-of-day (BEO) text kept on the row. shareToken powers the public
// read-only proposal link (/proposal/<token>). Created idempotently on first use
// by lib/venue-db.ts, which mirrors these shapes in CREATE TABLE IF NOT EXISTS.
model VenueEvent {
  id            String   @id @default(uuid())
  name          String
  eventType     String?
  leadId        String?
  spaces        Json     @default("[]")
  dateStart     String?
  dateEnd       String?
  guests        Int?
  status        String   @default("INQUIRY") // INQUIRY | TENTATIVE | BOOKED | COMPLETED | CANCELLED
  notes         String?
  proposalDraft String?
  beoDraft      String?
  shareToken    String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadId])
  @@index([status])
}

// One room's status on one date, edited by the venue team in admin. Overrides the
// JSON defaults in app/data/availability.json when the public calendar renders.
model AvailabilityBlock {
  id        String   @id @default(uuid())
  spaceId   String
  date      String // YYYY-MM-DD
  status    String // open | held | booked
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, date])
  @@index([date])
}

// Self-serve "express book" request from the public site: a guest asks for one
// room on one date. Staff approve (creates a tentative VenueEvent + held
// AvailabilityBlock) or decline. No payment is taken.
model ExpressBookRequest {
  id        String   @id @default(uuid())
  spaceId   String
  date      String // YYYY-MM-DD
  guests    Int?
  name      String
  email     String
  phone     String?
  notes     String?
  status    String   @default("PENDING") // PENDING | APPROVED | DECLINED
  leadId    String?
  eventId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// One lead's place in one journey.
model JourneyRun {
  id            String      @id @default(uuid())
  journeyId     String
  leadId        String
  status        String      @default("RUNNING") // RUNNING | DONE | STOPPED
  stepIndex     Int         @default(0)
  nextRunAt     DateTime?
  stoppedReason String?
  log           Json?
  startedAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  journey       Journey     @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  lead          LeadProfile @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([leadId])
}
