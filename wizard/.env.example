# E68 Wizard of Oz agency spine — every default below is the safe one.
# Copy to .env.local for local development. Never commit real values.

# Local/dev database ONLY. scripts/guard-dev-db.mjs refuses any non-local host and every
# BroyhillGOP production host, and requires the isolated wizard_agency schema.
WIZARD_AGENCY_DATABASE_URL="postgresql://dev:dev@127.0.0.1:5432/wizard_agency_dev?schema=wizard_agency"

# Schema changes (npm run db:push:dev) also require Ed's exact phrase for that run:
# WIZARD_SCHEMA_AUTHORIZATION="I AUTHORIZE THIS ACTION"

# Secrets (min 32 chars). Missing secrets fail closed: no sign-in, no unsubscribe, no webhooks.
WIZARD_SESSION_SECRET=""
WIZARD_UNSUBSCRIBE_SECRET=""
CAPTURE_WEBHOOK_SECRET=""
RESEND_WEBHOOK_SECRET=""

WIZARD_PUBLIC_BASE_URL="http://localhost:3000"

# Tenant fallback when no silo is selected: "default" (BroyhillGOP silo) or "none" (refuse).
WIZARD_TENANT_FALLBACK="default"

# Dispatch stays DRY_RUN unless ALL of: NODE_ENV=production, WIZARD_DISPATCH_MODE=LIVE,
# WIZARD_ED_LIVE_ORDER="<campaignId>:<contentHash>", kill switch released with the phrase,
# candidate-principal authorization of that exact hash, E20 GO, E10 clearance, and readable
# platform suppression lists. The E20/E10/platform adapters are unbound in this build.
WIZARD_DISPATCH_MODE="DRY_RUN"
WIZARD_ED_LIVE_ORDER=""
RESEND_API_KEY=""

# Forge drafting: deterministic by default. OpenAI is a paid call and needs explicit approval.
WIZARD_FORGE_PROVIDER="deterministic"
WIZARD_PAID_CALLS_AUTHORIZED="false"
OPENAI_API_KEY=""

# Dev seed admin (no default password is shipped).
WIZARD_SEED_ADMIN_EMAIL=""
WIZARD_SEED_ADMIN_PASSWORD=""

# Password for the dev fixture users that scripts/verify-routes-dev.ts creates (manager/drafter/
# viewer/candidate @example.com in the demo-candidate silo). Required by npm run verify:routes:dev;
# min 12 chars (hashPassword rejects shorter values).
WIZARD_DEV_USER_PASSWORD=""
