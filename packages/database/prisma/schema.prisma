datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  ADMIN
  STAFF
}

enum SuiteStatus {
  OCCUPIED
  VACANT
  RESERVED
}

enum TenantStatus {
  ACTIVE
  NOTICE_GIVEN
  FORMER
}

enum IntentSubject {
  COMMERCIAL_LEASE
  CONFERENCE_EVENT
}

enum AppointmentType {
  TOUR
  MEETING
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RsvpStatus {
  ATTENDING
  DECLINED
  CANCELLED
}

enum PaymentType {
  DEPOSIT
  BALANCE
  REFUND
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Suite {
  id           String        @id @default(uuid())
  number       String        @unique
  floor        Int
  squareFeet   Int
  monthlyRate  Float?
  status       SuiteStatus   @default(VACANT)
  description  String?       @db.Text
  featured     Boolean       @default(false)
  tenant       Tenant?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Tenant {
  id          String       @id @default(uuid())
  companyName String
  contactName String
  email       String
  phone       String?
  suiteId     String?      @unique
  suite       Suite?       @relation(fields: [suiteId], references: [id])
  leaseStart  DateTime?
  leaseEnd    DateTime?
  monthlyRent Float?
  status      TenantStatus @default(ACTIVE)
  emailOptIn  Boolean      @default(true)
  smsOptIn    Boolean      @default(false)
  notes       String?      @db.Text
  messages    MessageLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model LeadProfile {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String?
  companyName     String?
  phone           String?
  leadScore       Int            @default(0)
  leadStatus      String         @default("PROSPECT")
  intentSubject   IntentSubject
  eventType       String?
  targetSquareFt  Int?
  targetBudget    Float?
  leadSource      String         @default("INBOUND_PORTAL")
  lastContactedAt DateTime?
  onWaitlist      Boolean        @default(false)
  message         String?        @db.Text
  emailOptIn      Boolean        @default(true)
  smsOptIn        Boolean        @default(false)
  enrichmentData  Json?
  activities      LeadActivity[]
  appointments    Appointment[]
  bookings        Booking[]
  messages        MessageLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LeadActivity {
  id            String      @id @default(uuid())
  leadId        String
  lead          LeadProfile @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activityType  String
  scoreModifier Int
  metadata      Json?
  createdAt     DateTime    @default(now())
}

model Appointment {
  id           String            @id @default(uuid())
  type         AppointmentType   @default(TOUR)
  status       AppointmentStatus @default(REQUESTED)
  startTime    DateTime
  endTime      DateTime
  name         String
  email        String
  phone        String?
  notes        String?           @db.Text
  suiteId      String?
  suite        Suite?            @relation(fields: [suiteId], references: [id])
  leadId       String?
  lead         LeadProfile?      @relation(fields: [leadId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model EventSpace {
  id          String    @id @default(uuid())
  name        String    @unique
  capacity    Int
  hourlyRate  Float
  description String?   @db.Text
  active      Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id             String        @id @default(uuid())
  reference      String        @unique
  title          String
  eventType      String?
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(PENDING)
  expectedGuests Int?
  contactName    String
  contactEmail   String
  contactPhone   String?
  notes          String?       @db.Text
  totalAmount    Float         @default(0)
  depositAmount  Float         @default(0)
  eventSpaceId   String
  eventSpace     EventSpace    @relation(fields: [eventSpaceId], references: [id])
  leadId         String?
  lead           LeadProfile?  @relation(fields: [leadId], references: [id])
  rsvps          Rsvp[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Rsvp {
  id          String     @id @default(uuid())
  bookingId   String
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name        String
  email       String
  guests      Int        @default(1)
  status      RsvpStatus @default(ATTENDING)
  qrCodeToken String     @unique
  checkedIn   Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model Payment {
  id          String        @id @default(uuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id])
  type        PaymentType   @default(DEPOSIT)
  status      PaymentStatus @default(PENDING)
  amount      Float
  currency    String        @default("usd")
  provider    String        @default("stripe")
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MessageLog {
  id           String         @id @default(uuid())
  channel      MessageChannel
  status       MessageStatus  @default(QUEUED)
  to           String
  subject      String?
  body         String         @db.Text
  template     String?
  error        String?
  scheduledFor DateTime       @default(now())
  sentAt       DateTime?
  leadId       String?
  lead         LeadProfile?   @relation(fields: [leadId], references: [id])
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  createdAt    DateTime       @default(now())
}

model AiContentPipeline {
  id             String    @id @default(uuid())
  platform       String
  suggestedDraft String    @db.Text
  imageUrl       String?
  status         String
  scheduledFor   DateTime
  publishedAt    DateTime?
  metrics        Json?
  createdAt      DateTime  @default(now())
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
