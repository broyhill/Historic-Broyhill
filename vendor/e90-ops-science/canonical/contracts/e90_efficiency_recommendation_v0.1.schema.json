{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broyhillgop.local/contracts/e90_efficiency_recommendation_v0.1.schema.json",
  "title": "E90 Efficiency Recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation_id",
    "recommendation_version",
    "recommendation_sha256",
    "recommendation_class",
    "scope",
    "source_optimization_run_ref",
    "input_snapshot_ref",
    "baseline",
    "proposed_change",
    "efficiency_effects",
    "affected_ecosystems",
    "implementation_class",
    "alternatives",
    "constraints",
    "proof_state",
    "created_at",
    "expires_at",
    "execution_allowed"
  ],
  "properties": {
    "recommendation_id": {"type": "string", "format": "uuid"},
    "recommendation_version": {"type": "string", "minLength": 1},
    "recommendation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recommendation_class": {
      "enum": [
        "CAMPAIGN_PLAN_EFFICIENCY",
        "QUEUE_POLICY_EFFICIENCY",
        "CAPACITY_INVESTMENT",
        "DATA_QUALITY_EFFICIENCY",
        "MODEL_RECALIBRATION",
        "CONFIGURATION_CHANGE",
        "CODE_SCHEMA_DEPLOYMENT",
        "ADVISORY_ONLY"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "tenant_id", "candidate_id"],
      "properties": {
        "scope_kind": {"enum": ["GLOBAL_NONCANDIDATE", "CANDIDATE"]},
        "tenant_id": {"type": ["string", "null"], "format": "uuid"},
        "candidate_id": {"type": ["string", "null"], "format": "uuid"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope_kind": {"const": "CANDIDATE"}}},
          "then": {
            "properties": {
              "tenant_id": {"type": "string", "format": "uuid"},
              "candidate_id": {"type": "string", "format": "uuid"}
            }
          },
          "else": {
            "properties": {
              "tenant_id": {"type": "null"},
              "candidate_id": {"type": "null"}
            }
          }
        }
      ]
    },
    "source_optimization_run_ref": {"type": "string", "minLength": 1},
    "input_snapshot_ref": {"type": "string", "minLength": 1},
    "e72_plan_ref": {"type": ["string", "null"]},
    "baseline": {"type": "object", "minProperties": 1},
    "proposed_change": {"type": "object", "minProperties": 1},
    "efficiency_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "quality", "time", "flow", "outcome", "total"],
      "properties": {
        "resource": {"type": "number"},
        "quality": {"type": "number"},
        "time": {"type": "number"},
        "flow": {"type": "number"},
        "outcome": {"type": "number"},
        "total": {"type": "number"}
      }
    },
    "affected_ecosystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E[0-9]{2,3}$"}
    },
    "implementation_class": {
      "enum": [
        "ADVISORY",
        "CAMPAIGN_PLAN_INPUT",
        "QUEUE_POLICY",
        "CONFIGURATION",
        "CODE",
        "SCHEMA",
        "INFRASTRUCTURE",
        "EXTERNAL_ACTION"
      ]
    },
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "proof_state": {
      "enum": [
        "SIMULATION_ONLY",
        "FEASIBLE_NOT_OPTIMAL",
        "HEURISTIC_NOT_OPTIMAL",
        "OPTIMAL_PROVEN"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "execution_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recommendation_class": {"const": "CAMPAIGN_PLAN_EFFICIENCY"}
        }
      },
      "then": {
        "required": ["e72_plan_ref"],
        "properties": {"e72_plan_ref": {"type": "string", "minLength": 1}}
      }
    }
  ]
}
