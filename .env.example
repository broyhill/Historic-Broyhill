# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://broyhill_admin:change-me@localhost:5432/historic_broyhill
POSTGRES_PASSWORD=change-me

# API
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000
DEPOSIT_PERCENT=25

# First admin user (used by `pnpm prisma:seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SEED_SAMPLE_DATA=true   # adds placeholder suites and event spaces

# Payments (optional: deposits are recorded as "manual" without these)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional: messages are logged as SKIPPED without these)
SENDGRID_API_KEY=
MAIL_FROM=

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
