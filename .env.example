DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
CAPTURE_WEBHOOK_SECRET="change_this_secure_capture_token"
ADMIN_SECRET_KEY="broyhill_admin_change_this_secret"
OPENAI_API_KEY="sk-proj-your-openai-api-key"
RESEND_API_KEY=""
EMAIL_FROM="Historic Broyhill <outreach@historicbroyhill.com>"

# Devin/Codex (preferred for AI-powered campaign drafting, lead scoring, etc.)
CURSOR_API_KEY=""
# Optional: Override model (default: composer-2.5)
CURSOR_MODEL=""
# Optional: Set to "true" to use local runtime instead of cloud (default: false/cloud)
CURSOR_LOCAL="false"

# Claude (legacy fallback). Without CURSOR_API_KEY, app falls back to ANTHROPIC_API_KEY, then OPENAI_API_KEY.
ANTHROPIC_API_KEY=""
# Optional: claude-haiku-5-5 (cheaper) or claude-opus-5-5 (strongest). Default claude-sonnet-5-5.
ANTHROPIC_MODEL=""
# Groq (free tier, OpenAI-compatible). Used when ANTHROPIC_API_KEY is missing or a Claude call fails (e.g. out of credits).
GROQ_API_KEY=""
# Optional; defaults to llama-3.3-70b-versatile
GROQ_MODEL=""

# Free stock photos, videos and graphics in Photos (optional). Pixabay: free key at pixabay.com/api/docs.
# Pexels paused new keys; PEXELS_API_KEY only works if you already have one.
PIXABAY_API_KEY=""
PEXELS_API_KEY=""
