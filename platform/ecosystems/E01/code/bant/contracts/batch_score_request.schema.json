{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/broyhill/BroyhillGOP/bant/batch_score_request.schema.json",
  "title": "BANT Batch Score Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["silo_id", "items"],
  "properties": {
    "silo_id": { "type": "string", "minLength": 1 },
    "persist": { "type": "boolean", "default": false },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cluster_id"],
        "properties": {
          "cluster_id": { "type": "integer", "exclusiveMinimum": 0 },
          "jurisdiction_key": { "type": ["string", "null"] },
          "features": {
            "type": ["object", "null"],
            "additionalProperties": { "type": ["number", "boolean"] }
          }
        }
      }
    }
  }
}
